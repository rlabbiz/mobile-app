{
  "expo": {
    "name": "Koreva",
    "slug": "filmstream",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "koreva",
    "android": {
      "package": "com.filmstream.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#050518"
      }
    },
    "ios": {
      "bundleIdentifier": "com.filmstream.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark.png",
          "imageWidth": 180,
          "backgroundColor": "#050518",
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/brand/launch.jpg",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#050518"
          }
        }
      ]
    ],
    "icon": "./assets/brand/icon.png"
  }
}
