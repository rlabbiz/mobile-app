{
  "name": "koreva-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "start:usb": "node scripts/expo-usb.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx,.cjs App.tsx src scripts __tests__",
    "test": "jest",
