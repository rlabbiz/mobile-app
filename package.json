    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.19.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.6.3",
    "jest-expo": "~57.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
